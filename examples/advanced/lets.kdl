// Resilience and polish: gates, timeout, retry, silent, hidden commands,
// deprecation, multiple run commands, and rich help text.
//
// Try:
//   lets bundle          (second run skips: sources unchanged)
//   lets init            (skipped once .initialized exists; --force reruns)
//   lets guarded         (fails until you create allow.txt)
//   lets stack           (defer tears down even when the run fails)
//   lets health-check
//   lets deploy
//   lets old-deploy          (prints a deprecation warning)
//   lets ship --help         (long description + examples in help)
//   lets --list              (setup-db is hidden from this list)

description "Advanced — gates, timeouts, retries, and help polish"

// `defer`: guaranteed cleanup — runs on success, failure, or Ctrl-C,
// in reverse declaration order. `after` only runs on success.
stack {
    description "Bring a stack up, always tear it down"
    defer "echo stack down"
    run "echo stack up"
    run "echo running tests against stack"
}

// `sources` + `generates`: automatic fingerprint-based skipping. The second
// run is skipped unless a file under src/ changes or dist/ is deleted.
// Fingerprints live in a self-gitignored .lets/ directory.
bundle {
    description "Rebuild only when sources change"
    sources "src/**"
    generates "dist/**"
    run "sh -c 'mkdir -p dist && cp -r src/. dist/ && echo bundled'"
}

// `status`: when every check exits 0 the task is up to date and skipped.
// Deps still run first. Use --force to run anyway.
init {
    description "One-time project setup"
    status "test -f .initialized"
    run "echo setting up project"
    run "echo run: touch .initialized"
}

// `precondition`: refuse to run (before deps!) unless a check passes,
// with a message telling the user how to fix it.
guarded {
    description "Only runs when allow.txt exists"
    precondition "test -f allow.txt" message="Create allow.txt to enable this task"
    run "echo allowed"
}

// Kill after a deadline; retry with a delay between attempts.
health-check {
    description "Probe the service until it responds"
    timeout "10s"
    retry count=3 delay="1s"
    run "echo curl -f http://localhost:3000/health"
}

// Hidden commands stay out of --list and --help but still run —
// useful for plumbing tasks that only exist to be depended on.
setup-db {
    hide
    run "echo diesel database setup"
}

// Multiple run commands execute sequentially, stopping on failure.
deploy {
    deps "setup-db"
    run "echo building image"
    run "echo pushing image"
    run "echo restarting service"
}

// Deprecated commands keep working but warn, with a migration hint.
old-deploy {
    deprecated "Use 'deploy' instead"
    run "echo legacy deploy"
}

// `long-description` and `examples` render in `lets ship --help`.
ship {
    description "Build and publish a release"
    long-description """
        Builds an optimized binary, runs the health check, and
        publishes the result. Requires network access.
        """
    examples """
        lets ship              Publish a release
        lets --dry-run ship    Show the plan without running it
        """
    deps "health-check"
    run "echo shipping"
}
